rules_version = '2';

// Quién puede usar Workhub y qué puede tocar.
//
// 1. Cualquiera puede crearse una cuenta. Las cuentas de correo y contraseña
//    tienen que verificar el correo antes de leer o guardar nada (así no se
//    pueden crear cuentas en masa con correos inventados). Google y GitHub
//    ya llegan con la identidad comprobada por el proveedor.
// 2. Cada cuenta solo puede leer y escribir en users/{su uid}/…, y solo en
//    las colecciones que usa la app: nada de guardar datos arbitrarios.
// 3. Proyectos de equipo: viven en teams/{id}. Solo entran los miembros
//    (memberIds), con un rol: owner (todo), editor (datos del proyecto) o
//    viewer (solo lectura). Se entra por invitación (invites/{id}), dirigida
//    a un correo verificado. Las contraseñas del gestor no se comparten
//    todavía, así que vault y vault_meta no están permitidos en equipos.
// 4. Cifrado por proyecto (docs/CIFRADO-PROYECTOS.md). Un proyecto puede
//    llevar el campo 'enc' (solo al crearse): sus documentos de datos se
//    guardan sellados (campos 'e', 'ev' y 'kid') y las reglas no dejan
//    degradarlos a texto en claro. Los proyectos sin 'enc' funcionan igual
//    que siempre. 'github' y 'enc' son incompatibles.
// 5. Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    function canUse(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && (request.auth.token.firebase.sign_in_provider != 'password'
            || request.auth.token.email_verified == true);
    }

    // Cualquier cuenta con la identidad comprobada (correo verificado si es de
    // correo y contraseña).
    function verified() {
      return request.auth != null
        && (request.auth.token.firebase.sign_in_provider != 'password'
            || request.auth.token.email_verified == true);
    }

    // Colecciones de datos de un proyecto de equipo (sin el gestor de contraseñas).
    function isTeamCollection(col) {
      return col in ['tasks', 'clients', 'contacts', 'meetings', 'plugin_data', 'assets'];
    }

    function team(tid) {
      return get(/databases/$(database)/documents/teams/$(tid)).data;
    }

    function isMember(tid) {
      return verified() && request.auth.uid in team(tid).memberIds;
    }

    function canEdit(tid) {
      return isMember(tid) && team(tid).members[request.auth.uid].role in ['owner', 'editor'];
    }

    function isOwner(tid) {
      return isMember(tid) && team(tid).members[request.auth.uid].role == 'owner';
    }

    // Colecciones con los datos de un proyecto.
    function isDataCollection(col) {
      return col in ['tasks', 'clients', 'contacts', 'meetings', 'vault', 'vault_meta', 'plugin_data'];
    }

    function textWithin(data, key, max) {
      return data.get(key, '') is string && data.get(key, '').size() <= max;
    }

    function listWithin(data, key, max) {
      return data.get(key, []) is list && data.get(key, []).size() <= max;
    }

    // Validación del servidor: el cliente puede modificarse, estas reglas no.
    function validData(col) {
      let data = request.resource.data;
      return data.keys().size() <= 50
        && (col != 'tasks' || (data.keys().hasOnly([
            'title', 'desc', 'cliente', 'status', 'contacto', 'dueDate', 'repeat',
            'checklist', 'labels', 'assignees', 'linkedContacts', 'linkedVault',
            'order', 'createdAt', 'updatedAt', 'repeatSpawned', 'ghItemId',
            'ghContentId', 'ghType', 'ghUrl', 'ghNumber', 'ghRepo', 'ghLabels',
            'ghPrs', 'ghSyncedAt', 'ghRemoteAt'
          ]) && textWithin(data, 'title', 500)
          && textWithin(data, 'desc', 20000)
          && textWithin(data, 'cliente', 200)
          && listWithin(data, 'labels', 60)
          && listWithin(data, 'checklist', 100)
          && listWithin(data, 'assignees', 50)))
        && (col != 'clients' || (data.keys().hasOnly(['nombre', 'color', 'createdAt'])
          && textWithin(data, 'nombre', 200)))
        && (col != 'contacts' || (data.keys().hasOnly([
            'cliente', 'nombre', 'email', 'telefono', 'notas', 'createdAt', 'updatedAt'
          ]) && textWithin(data, 'nombre', 200)
          && textWithin(data, 'email', 320) && textWithin(data, 'notas', 10000)))
        && (col != 'meetings' || (data.keys().hasOnly([
            'title', 'cliente', 'date', 'start', 'end', 'link', 'notas', 'createdAt', 'updatedAt'
          ]) && textWithin(data, 'title', 500)
          && textWithin(data, 'notas', 20000) && textWithin(data, 'link', 2048)))
        && (col != 'vault' || (data.keys().hasOnly([
            'tipo', 'cliente', 'label', 'correo', 'web', 'ip', 'usuario', 'puerto',
            'dominio', 'iv', 'cipher', 'ivV2', 'cipherV2', 'order', 'createdAt', 'updatedAt'
          ]) && textWithin(data, 'label', 500)
          && textWithin(data, 'cipher', 900000) && textWithin(data, 'cipherV2', 900000)))
        && (col != 'assets' || (data.keys().hasOnly(['data', 'contentType', 'createdAt'])
          && textWithin(data, 'data', 900000)))
        && (col != 'projects' || (textWithin(data, 'nombre', 200)
          && listWithin(data, 'stages', 8) && listWithin(data, 'labels', 60)))
        && (col != 'notes' || (data.keys().hasOnly([
            'text', 'imageAssetId', 'createdAt', 'kind', 'actorUid', 'actorName'
          ]) && textWithin(data, 'text', 20000)
          && textWithin(data, 'actorName', 200)));
    }

    // ---------- Cifrado por proyecto ----------

    // Un documento sellado lleva la versión del esquema ('ev', entero >= 1).
    function isSealed(d) {
      return d.get('ev', 0) is int && d.get('ev', 0) >= 1;
    }

    // Colecciones que pueden llevar documentos sellados.
    function isSealable(col) {
      return col in ['tasks', 'notes', 'clients', 'contacts', 'meetings', 'vault', 'plugin_data', 'assets'];
    }

    // Campos permitidos en un documento sellado: los que necesitan las reglas,
    // las consultas del servidor y las actualizaciones parciales, más e/ev/kid.
    function encFields(col) {
      return col == 'tasks' ? ['status', 'order', 'dueDate', 'repeat', 'repeatSpawned', 'createdAt', 'updatedAt',
                               'assignees', 'linkedContacts', 'linkedVault', 'e', 'ev', 'kid']
        : col == 'notes' ? ['createdAt', 'kind', 'actorUid', 'imageAssetId', 'e', 'ev', 'kid']
        : col == 'clients' ? ['color', 'createdAt', 'e', 'ev', 'kid']
        : col == 'contacts' ? ['createdAt', 'updatedAt', 'e', 'ev', 'kid']
        : col == 'meetings' ? ['date', 'createdAt', 'updatedAt', 'e', 'ev', 'kid']
        : col == 'vault' ? ['order', 'createdAt', 'updatedAt', 'iv', 'cipher', 'ivV2', 'cipherV2', 'e', 'ev', 'kid']
        : col == 'plugin_data' ? ['updatedAt', 'e', 'ev', 'kid']
        : col == 'assets' ? ['createdAt', 'e', 'ev', 'kid']
        : [];
    }

    // Tamaño máximo del bloque cifrado 'e' (caracteres).
    function encMax(col) {
      return col == 'tasks' ? 200000
        : col == 'notes' ? 100000
        : col == 'clients' ? 4000
        : col == 'contacts' ? 50000
        : col == 'meetings' ? 100000
        : col == 'vault' ? 20000
        : 900000;
    }

    function validSealed(col) {
      let d = request.resource.data;
      return d.ev == 1
        && d.kid is string && d.kid.size() > 0 && d.kid.size() <= 32
        && d.e is string && d.e.size() > 0 && d.e.size() <= encMax(col)
        && d.keys().hasOnly(encFields(col))
        && listWithin(d, 'assignees', 50)
        && textWithin(d, 'cipher', 900000) && textWithin(d, 'cipherV2', 900000);
    }

    // Un documento sellado nunca vuelve a texto en claro ni baja de versión.
    function keepsSeal() {
      return resource == null || !isSealed(resource.data)
        || (isSealed(request.resource.data) && request.resource.data.ev >= resource.data.ev);
    }

    // Escritura de datos: sellada con su forma, o en claro con la validación de siempre.
    function validWrite(col) {
      return !isSealable(col) ? validData(col)
        : keepsSeal() && (isSealed(request.resource.data) ? validSealed(col) : validData(col));
    }

    // Marca de instalación de un plugin (plugin_data/install:{id}): no es contenido del usuario y se consulta por _kind.
    function isInstallMark() {
      let d = request.resource.data;
      return d.get('_kind', '') == 'plugin-install'
        && d.keys().hasOnly(['_kind', 'pluginId', 'url', 'manifest', 'granted', 'official', 'installedAt', 'updatedAt']);
    }

    // true si, en un proyecto cifrado, esta escritura tiene que ir sellada.
    // vault_meta (la clave del cofre, ya envuelta) y las marcas de plugins pueden ir en claro.
    function sealRequired(col) {
      return isSealable(col) && !(col == 'plugin_data' && isInstallMark());
    }

    function personalEnc(uid, pid) {
      let p = /databases/$(database)/documents/users/$(uid)/projects/$(pid);
      return exists(p) && get(p).data.get('enc', null) != null;
    }

    function teamEnc(tid) {
      return team(tid).get('enc', null) != null;
    }

    function wrapBlob(b, max) {
      return b is map && b.keys().hasOnly(['iv', 'ct'])
        && b.iv is string && b.iv.size() >= 12 && b.iv.size() <= 32
        && b.ct is string && b.ct.size() > 0 && b.ct.size() <= max;
    }

    // Campo 'enc' del documento del proyecto. Modo 'pw' (cifrado total: la clave se abre con la
    // contraseña del proyecto) o 'managed' (gestionado: la clave que la envuelve la custodia el
    // Worker de Kanlane). Los equipos solo admiten 'pw'.
    function validEnc(e) {
      return e is map && e.keys().hasOnly(['v', 'mode', 'pid', 'kid', 'kcv', 'createdAt'])
        && e.keys().hasAll(['v', 'mode', 'pid', 'kid', 'kcv'])
        && e.v == 1 && e.mode in ['pw', 'managed']
        && e.pid is string && e.pid.size() >= 16 && e.pid.size() <= 32
        && e.kid is string && e.kid.size() >= 8 && e.kid.size() <= 32
        && e.kcv is string && e.kcv.size() > 0 && e.kcv.size() <= 128;
    }

    // 'enc' se pone al crear el proyecto (o al recrear el principal marcado como borrado), no cambia
    // después y no convive con 'github'.
    function validProjectEnc() {
      let d = request.resource.data;
      let had = resource != null && resource.data.get('enc', null) != null;
      let has = d.get('enc', null) != null;
      return (!has || (validEnc(d.enc) && d.get('github', null) == null))
        && (!had || (has && d.enc == resource.data.enc) || (d.get('deleted', false) == true && !has))
        && (had || !has || resource == null || resource.data.get('deleted', false) == true);
    }

    // Envoltorio de la clave de datos de una persona: crypto/{uid}. Con la contraseña y la clave de
    // recuperación (cifrado total) o con la clave del Worker (gestionado), nunca las dos cosas.
    function validCrypto() {
      return ('kms' in request.resource.data) ? validKmsCrypto() : validPwCrypto();
    }

    function validKmsCrypto() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'kid', 'kms', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['v', 'kid', 'kms'])
        && d.v == 1
        && d.kid is string && d.kid.size() >= 8 && d.kid.size() <= 32
        && d.kms is map && d.kms.keys().hasOnly(['iv', 'ct', 'kmsv']) && d.kms.keys().hasAll(['iv', 'ct', 'kmsv'])
        && d.kms.iv is string && d.kms.iv.size() >= 12 && d.kms.iv.size() <= 32
        && d.kms.ct is string && d.kms.ct.size() > 0 && d.kms.ct.size() <= 256
        && d.kms.kmsv is int && d.kms.kmsv >= 1 && d.kms.kmsv <= 1000;
    }

    function validPwCrypto() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'kid', 'kdf', 'pw', 'rk', 'pub', 'priv', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['v', 'kid', 'kdf', 'pw', 'rk'])
        && d.v == 1
        && d.kid is string && d.kid.size() >= 8 && d.kid.size() <= 32
        && d.kdf is map && d.kdf.keys().hasOnly(['name', 'hash', 'iter', 'salt'])
        && d.kdf.name == 'PBKDF2' && d.kdf.hash == 'SHA-256'
        && d.kdf.iter is int && d.kdf.iter >= 600000 && d.kdf.iter <= 10000000
        && d.kdf.salt is string && d.kdf.salt.size() >= 16 && d.kdf.salt.size() <= 64
        && wrapBlob(d.pw, 256) && wrapBlob(d.rk, 256)
        && (!('pub' in d) || (d.pub is map && d.pub.keys().size() <= 8))
        && (!('priv' in d) || wrapBlob(d.priv, 1024));
    }

    match /users/{uid} {
      // Proyecto principal: sus datos cuelgan directamente de users/{uid}.
      // 'settings' guarda preferencias y storage.user de los plugins.
      // 'plugins' conserva las instalaciones del proyecto principal.
      match /{col}/{docId} {
        allow read: if canUse(uid) && (isDataCollection(col) || col in ['projects', 'assets', 'settings', 'plugins']);
        allow create: if canUse(uid) && (isDataCollection(col) || col in ['projects', 'assets', 'settings', 'plugins'])
          && validWrite(col)
          && (col != 'projects' || validProjectEnc())
          && (!sealRequired(col) || col == 'assets' || isSealed(request.resource.data) || !personalEnc(uid, 'main'));
        allow update: if canUse(uid) && (isDataCollection(col) || col in ['projects', 'assets', 'settings', 'plugins'])
          && validWrite(col)
          && (col != 'projects' || validProjectEnc());
        allow delete: if canUse(uid) && (isDataCollection(col) || col in ['projects', 'assets', 'settings', 'plugins']);
      }
      match /tasks/{taskId}/notes/{noteId} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid) && validWrite('notes')
          && (isSealed(request.resource.data) || !personalEnc(uid, 'main'));
        allow update: if canUse(uid) && validWrite('notes');
      }

      // Envoltorio de la clave de datos del proyecto principal (solo lo lee y escribe su dueño).
      match /crypto/{who} {
        allow read, delete: if canUse(uid) && who == uid;
        allow create, update: if canUse(uid) && who == uid && validCrypto();
      }

      // Resto de proyectos: las mismas colecciones bajo projects/{id}.
      match /projects/{projectId}/{col}/{docId} {
        allow read, delete: if canUse(uid) && isDataCollection(col);
        allow create: if canUse(uid) && isDataCollection(col) && validWrite(col)
          && (!sealRequired(col) || isSealed(request.resource.data) || !personalEnc(uid, projectId));
        allow update: if canUse(uid) && isDataCollection(col) && validWrite(col);
      }
      match /projects/{projectId}/tasks/{taskId}/notes/{noteId} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid) && validWrite('notes')
          && (isSealed(request.resource.data) || !personalEnc(uid, projectId));
        allow update: if canUse(uid) && validWrite('notes');
      }
      match /projects/{projectId}/crypto/{who} {
        allow read, delete: if canUse(uid) && who == uid;
        allow create, update: if canUse(uid) && who == uid && validCrypto();
      }

      match /backup_versions/{backupId} {
        allow read, delete: if canUse(uid);
        allow create: if canUse(uid)
          && request.resource.data.keys().hasOnly(['projectId', 'createdAt', 'iv', 'chunkCount', 'complete', 'counts'])
          && request.resource.data.keys().hasAll(['projectId', 'createdAt', 'iv', 'chunkCount', 'complete', 'counts'])
          && request.resource.data.projectId is string && request.resource.data.projectId.size() <= 128
          && request.resource.data.createdAt is number
          && request.resource.data.iv is string && request.resource.data.iv.size() <= 32
          && request.resource.data.chunkCount is int && request.resource.data.chunkCount > 0
          && request.resource.data.chunkCount <= 16 && request.resource.data.complete == false
          && request.resource.data.counts is map && request.resource.data.counts.keys().size() <= 10;
        allow update: if canUse(uid) && resource.data.complete == false
          && request.resource.data.complete == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['complete']);

        match /chunks/{chunkId} {
          allow read, delete: if canUse(uid);
          allow create: if canUse(uid)
            && get(/databases/$(database)/documents/users/$(uid)/backup_versions/$(backupId)).data.complete == false
            && request.resource.data.keys().hasOnly(['index', 'data'])
            && request.resource.data.keys().hasAll(['index', 'data'])
            && request.resource.data.index is int && request.resource.data.index >= 0
            && request.resource.data.index < 16
            && request.resource.data.data is string && request.resource.data.data.size() <= 300000;
          allow update: if false;
        }
      }
    }

    // ---------- Proyectos de equipo ----------
    match /teams/{tid} {
      allow read: if verified() && request.auth.uid in resource.data.memberIds;

      // El que lo crea es su único miembro y su propietario.
      allow create: if verified()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.members[request.auth.uid].role == 'owner'
        && (request.resource.data.get('enc', null) == null
            || (validEnc(request.resource.data.enc) && request.resource.data.enc.mode == 'pw'
                && request.resource.data.get('github', null) == null));

      // El cifrado de un equipo no cambia después de crearlo y no convive con 'github'.
      allow update: if verified()
        && request.resource.data.get('enc', null) == resource.data.get('enc', null)
        && (request.resource.data.get('enc', null) == null || request.resource.data.get('github', null) == null)
        && (
        // El propietario cambia lo que quiera, menos quién es el propietario.
        (resource.data.members[request.auth.uid].role == 'owner'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerUid in request.resource.data.memberIds)
        // Un editor cambia la configuración del proyecto, no los miembros.
        || (request.auth.uid in resource.data.memberIds
          && resource.data.members[request.auth.uid].role == 'editor'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.members == resource.data.members)
        // Cualquiera que no sea el propietario puede salir del equipo.
        || (request.auth.uid in resource.data.memberIds
          && resource.data.members[request.auth.uid].role != 'owner'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && !(request.auth.uid in request.resource.data.members))
        // Entrar con una invitación hecha a tu correo, con el rol invitado.
        || (!(request.auth.uid in resource.data.memberIds)
          && request.auth.token.email_verified == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members'])
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.members[request.auth.uid].role ==
             get(/databases/$(database)/documents/invites/$(tid + '_' + request.auth.token.email.lower())).data.role)
      );

      allow delete: if verified() && resource.data.members[request.auth.uid].role == 'owner';
    }

    match /teams/{tid}/{col}/{docId} {
      allow read: if isTeamCollection(col) && isMember(tid);
      allow delete: if isTeamCollection(col) && canEdit(tid);
      allow create: if isTeamCollection(col) && canEdit(tid) && validWrite(col)
        && (!sealRequired(col) || isSealed(request.resource.data) || !teamEnc(tid));
      allow update: if isTeamCollection(col) && canEdit(tid) && validWrite(col);
    }
    match /teams/{tid}/tasks/{taskId}/notes/{noteId} {
      allow read: if isMember(tid);
      allow delete: if canEdit(tid);
      allow create: if canEdit(tid) && validWrite('notes')
        && (isSealed(request.resource.data) || !teamEnc(tid));
      allow update: if canEdit(tid) && validWrite('notes');
    }

    // Envoltorio de la clave del proyecto de cada miembro: lo lee y escribe cada uno; el propietario puede borrar los de otros.
    match /teams/{tid}/crypto/{who} {
      allow read: if verified() && who == request.auth.uid && isMember(tid);
      allow create, update: if verified() && who == request.auth.uid && validPwCrypto()
        && (isMember(tid)
            || request.auth.uid in getAfter(/databases/$(database)/documents/teams/$(tid)).data.memberIds);
      allow delete: if verified() && (who == request.auth.uid || isOwner(tid));
    }

    // Invitaciones: id = {idDelEquipo}_{correo en minúsculas}. Las lee y
    // rechaza quien las recibe, y las crea y revoca el propietario.
    match /invites/{inviteId} {
      allow read: if verified()
        && (resource.data.invitedByUid == request.auth.uid
            || (request.auth.token.email_verified == true
                && resource.data.email == request.auth.token.email.lower()));
      allow create, update: if verified()
        && request.resource.data.invitedByUid == request.auth.uid
        && isOwner(request.resource.data.teamId)
        && inviteId == request.resource.data.teamId + '_' + request.resource.data.email
        && request.resource.data.email == request.resource.data.email.lower()
        && request.resource.data.role in ['editor', 'viewer'];
      allow delete: if verified()
        && (resource.data.invitedByUid == request.auth.uid
            || isOwner(resource.data.teamId)
            || (request.auth.token.email_verified == true
                && resource.data.email == request.auth.token.email.lower()));

      // Clave del proyecto envuelta con el código de acceso. Va en una subcolección para que la
      // caducidad (24 h desde que la crea el servidor) se aplique al leerla, algo que una consulta
      // de invitaciones no podría comprobar. Solo la lee el destinatario.
      match /key/{k} {
        function inv() {
          return get(/databases/$(database)/documents/invites/$(inviteId)).data;
        }
        function invAfter() {
          return getAfter(/databases/$(database)/documents/invites/$(inviteId)).data;
        }
        allow read: if k == 'wrap' && verified() && request.auth.token.email_verified == true
          && inv().email == request.auth.token.email.lower()
          && request.time < resource.data.createdAt + duration.value(24, 'h');
        allow create: if k == 'wrap' && verified()
          && invAfter().invitedByUid == request.auth.uid
          && isOwner(invAfter().teamId)
          && request.resource.data.keys().hasOnly(['salt', 'iter', 'iv', 'ct', 'kid', 'kcv', 'createdAt'])
          && request.resource.data.keys().hasAll(['salt', 'iter', 'iv', 'ct', 'createdAt'])
          && request.resource.data.createdAt == request.time
          && request.resource.data.iter is int && request.resource.data.iter >= 100000
          && request.resource.data.iter <= 10000000
          && request.resource.data.salt is string && request.resource.data.salt.size() <= 64
          && request.resource.data.iv is string && request.resource.data.iv.size() <= 32
          && request.resource.data.ct is string && request.resource.data.ct.size() <= 256;
        allow update: if false;
        allow delete: if k == 'wrap' && verified()
          && (inv().invitedByUid == request.auth.uid
              || (request.auth.token.email_verified == true
                  && inv().email == request.auth.token.email.lower()));
      }
    }
  }
}
