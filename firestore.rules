rules_version = '2';

// Quién puede usar Workhub y qué puede tocar.
//
// 1. Lista de acceso: solo entran las cuentas que tengan un documento en
//    allowlist/{uid}. Esa colección solo se puede editar desde la consola de
//    Firebase (Firestore Database → Datos), nunca desde la web. Así, aunque
//    cualquiera pueda crearse una cuenta, sin estar en la lista no puede leer
//    ni guardar nada (ni gastar la cuota gratuita del proyecto).
// 2. Cada cuenta de la lista solo puede leer y escribir en users/{su uid}/….
// 3. Todo lo demás está cerrado.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowed() {
      return signedIn() && exists(/databases/$(database)/documents/allowlist/$(request.auth.uid));
    }

    // Cada cuenta puede comprobar si está en la lista (para avisar en la app),
    // pero nadie puede añadirse ni borrarse.
    match /allowlist/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if isAllowed() && request.auth.uid == uid;
    }
  }
}
