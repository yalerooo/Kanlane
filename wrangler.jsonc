{
  // Configuración de Cloudflare Workers (guía: docs/CLOUDFLARE.md).
  // "name" tiene que ser IGUAL al nombre del Worker en el panel de Cloudflare.
  "name": "workhub",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",

  // La web: lo que genera "node scripts/build-public.js" (index.html, assets,
  // src, plugins y _headers). El Worker de "main" solo atiende /__/auth/* y
  // /__/firebase/* (login de Firebase) y /__/kms/* (clave de los proyectos
  // «Gestionado por Kanlane»; necesita el secreto KMS_MASTER_V1, que se pone con
  // "npx wrangler secret put KMS_MASTER_V1" y NO va en este archivo: ver
  // docs/CLOUDFLARE.md). El resto lo sirven estos recursos.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Una dirección que no existe responde 404 con la página 404.html más cercana
    // (en/404.html para /en/…, 404.html para el resto). Sin esto el 404 va vacío.
    "not_found_handling": "404-page",
    // OJO: con "404-page", una dirección que no es un archivo NO llega al Worker: responde la
    // página 404. Por eso toda ruta que atienda el Worker tiene que estar en "run_worker_first",
    // también /__/auth/* y /__/firebase/* (sin ellas el acceso con Google o GitHub da 404).
    // Solo las páginas pasan antes por el Worker (redirecciones entre dominios y
    // cabecera noindex del espejo). Los scripts, estilos e imágenes se sirven
    // directamente, sin gastar peticiones del Worker (100 000 al día en el plan gratuito).
    "run_worker_first": ["/", "/index.html", "/app/*", "/demo/*", "/alternativa-a-trello", "/alternativa-a-trello/*", "/alternativa-a-asana", "/alternativa-a-asana/*", "/alternativa-a-notion", "/alternativa-a-notion/*", "/gestion-de-proyectos", "/gestion-de-proyectos/*", "/gestor-de-clientes", "/gestor-de-clientes/*", "/crm-para-autonomos", "/crm-para-autonomos/*", "/gestor-de-contrasenas-para-clientes", "/gestor-de-contrasenas-para-clientes/*", "/servidor-mcp", "/servidor-mcp/*", "/en", "/en/*", "/legal/*", "/sw.js", "/__/auth/*", "/__/firebase/*", "/__/kms/*", "/__/capture/*", "/__/mcp/*"]
  },

  // Dominios (todos apuntan a este mismo Worker; ver worker/index.js):
  //   kanlane.com          el definitivo (zona en esta cuenta de Cloudflare)
  //   www.kanlane.com      redirige al anterior
  //   kanlane.yalero.net   respaldo: sirve la misma web, con noindex
  //   workhub.yalero.net   nombre antiguo: redirige al definitivo
  // Al desplegar, Cloudflare conecta cada uno solo (las zonas tienen que estar en
  // esta cuenta). Si prefieres añadirlos a mano en el panel, borra esto.
  "routes": [
    { "pattern": "kanlane.com", "custom_domain": true },
    { "pattern": "www.kanlane.com", "custom_domain": true },
    { "pattern": "kanlane.yalero.net", "custom_domain": true },
    { "pattern": "workhub.yalero.net", "custom_domain": true }
  ],

  // Automatizaciones por fecha con Kanlane cerrado (worker/automations.mjs): cada 30 minutos.
  // Necesita el secreto FIREBASE_SERVICE_ACCOUNT ("npx wrangler secret put FIREBASE_SERVICE_ACCOUNT",
  // el JSON de una cuenta de servicio con el rol «Usuario de Cloud Datastore»: ver
  // docs/AUTOMATIZACIONES.md). Sin el secreto, el cron no hace nada.
  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  // A dónde mandan los dominios antiguos. Para volver al respaldo si kanlane.com
  // da problemas: pon "https://kanlane.yalero.net" y despliega. LEGACY_STATUS pasa a
  // "301" (permanente) cuando todo esté probado: una 301 se queda en la caché de los
  // navegadores y es mucho más difícil de deshacer.
  "vars": {
    "REDIRECT_TARGET": "https://kanlane.com",
    "LEGACY_STATUS": "302",

    // Captura de tareas por correo (worker/capture.mjs, docs/CAPTURA-EMAIL.md).
    // CAPTURE_DOMAINS: dominios cuyo correo entrega Email Routing a este Worker, separados por
    //   comas. El primero es el que enseña la app; los demás son de respaldo (la misma dirección
    //   vale en todos). Vacío = captura apagada: la app no enseña el apartado y todo correo se rechaza.
    //   Tienen que ser dominios raíz (Email Routing no admite la regla «Catch-all» en subdominios).
    //   Ejemplo: "kanlane.com,yalero.net".
    // CAPTURE_PLAN: "free" o "paid", según el plan de Workers de la cuenta. Solo cambia los topes:
    //   "free" admite mensajes de 8 MB (con 10 ms de CPU, un correo con adjuntos grandes puede
    //   quedarse sin ellos); "paid", de 25 MB. Al pasar la cuenta a Workers Paid, cambia esto a "paid".
    // Además hacen falta dos secretos (NO van aquí): CAPTURE_SECRET y FIREBASE_SERVICE_ACCOUNT.
    "CAPTURE_DOMAINS": "kanlane.com",
    "CAPTURE_PLAN": "free"
  },

  // Solo las peticiones que pasan por este Worker. Auth y Firestore directos
  // se protegen por separado con Firebase App Check y sus cuotas.
  "ratelimits": [{
    "name": "AUTH_RATE_LIMIT",
    "namespace_id": "73001",
    "simple": { "limit": 240, "period": 60 }
  }, {
    // Códigos de la verificación en dos pasos del gestor de contraseñas (/__/kms/v1/totp),
    // por cuenta: un código son 6 cifras y este límite es lo que impide probarlos todos.
    // Sin este límite la ruta responde 503.
    "name": "TOTP_RATE_LIMIT",
    "namespace_id": "73002",
    "simple": { "limit": 3, "period": 60 }
  }, {
    // Servidor MCP (/__/mcp/v1, worker/mcp.mjs, docs/MCP.md): llamadas por token y minuto.
    // Además hace falta el secreto MCP_SECRET (NO va aquí; "npx wrangler secret put MCP_SECRET",
    // 32 bytes al azar en base64) y el FIREBASE_SERVICE_ACCOUNT del cron. Sin MCP_SECRET la ruta
    // responde 503 y nadie puede crear tokens.
    "name": "MCP_RATE_LIMIT",
    "namespace_id": "73003",
    "simple": { "limit": 60, "period": 60 }
  }],

  // Registros, trazas e incidencias del Worker (el reenvío del login). Es lo
  // que Cloudflare tenía activado en el panel; se deja aquí para que los
  // despliegues no lo cambien. "redact_query_string" oculta la query de las
  // URL en los registros (el login lleva parámetros en ella).
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issues": {
      "enabled": true
    }
  }
}
